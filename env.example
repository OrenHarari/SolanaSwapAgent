# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Your Wallet Private Key (base58 encoded)
# Generate new keypair: solana-keygen new --outfile wallet.json
# Convert to base58: cat wallet.json | jq -r '.[0:32] | @base64d | @base58'
WALLET_PRIVATE_KEY=your_private_key_here

# Program ID (will be deployed to devnet)
SWAP_AGENT_PROGRAM_ID=BPF1111111111111111111111111111111111111111

# Trading Parameters
MIN_PROFIT_THRESHOLD=0.01      # Minimum profit in SOL
MAX_SLIPPAGE_BPS=50           # Maximum slippage (0.5%)
MAX_POSITION_SIZE=1.0         # Maximum position size in SOL
PRICE_UPDATE_INTERVAL=0.1     # Price update interval in seconds
MAX_CONCURRENT_SWAPS=3        # Max concurrent trades

# DEX APIs
JUPITER_API_URL=https://quote-api.jup.ag/v6
RAYDIUM_API_URL=https://api.raydium.io/v2

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# MEV Protection (optional)
USE_JITO_BUNDLES=false
JITO_TIP_AMOUNT=0.0001 